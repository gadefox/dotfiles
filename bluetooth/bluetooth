#!/bin/rc
. /usr/local/libexec/rc/notify
notify_icon = bluetooth
notify_title = Bluetooth:

if (~ $1 1) {
  sudo rfkill-bt 1
  systemctl --user start obex.service
  notify_show 'The device is turned on.'
  exit 0
}

if (~ $1 2) {
  sudo rfkill-bt 2
  systemctl --user stop obex.service
  notify_show 'The device is turned off.'
  exit 0
}

if (~ $1 3) {
  ~ `(systemctl is-active bluetooth) active && exit 0
  notify_show 'No Adapters present.'
}

exit 1
